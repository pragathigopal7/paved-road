# Scale on consumer lag, not CPU: a consumer that is waiting on a slow downstream is
# idle on CPU while lag grows. Keep maxReplicaCount at or below the partition count,
# since extra consumers in a group sit idle.
apiVersion: keda.sh/v1alpha1
kind: ScaledObject
metadata:
  name: @@service_name@@
  labels:
    app.kubernetes.io/name: @@service_name@@
    team: @@team@@
spec:
  scaleTargetRef:
    name: @@service_name@@
  minReplicaCount: 2
  maxReplicaCount: @@max_replicas@@
  cooldownPeriod: 300
  triggers:
    - type: kafka
      metadata:
        bootstrapServers: @@bootstrap_servers@@
        consumerGroup: @@consumer_group@@
        topic: @@topic@@
        lagThreshold: "500"
        offsetResetPolicy: earliest
